{
  "name": "@flamboyantengineer/ui-components",
  "version": "0.1.0",
  "description": "Unstyled, accessible React components that expose documented styling hooks for a host stylesheet.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamboyantEngineer/ui-components.git"
  },
  "browserslist": [
    "chrome >= 117",
    "edge >= 117",
    "firefox >= 121",
    "safari >= 17",
    "ios_saf >= 17"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./labs": {
      "types": "./dist/labs/index.d.ts",
      "import": "./dist/labs/index.js",
      "default": "./dist/labs/index.js"
    },
    "./tooling/eslint": "./tooling/eslint.mjs",
    "./tooling/prettier": "./tooling/prettier.json",
    "./tooling/lib/*.mjs": "./tooling/lib/*.mjs",
    "./locales": {
      "types": "./dist/core/locales/index.d.ts",
      "import": "./dist/core/locales/index.js",
      "default": "./dist/core/locales/index.js"
    },
    "./locales/*.json": "./dist/core/locales/*.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./reference.css": "./labs/build/reference.css",
    "./fonts.css": "./labs/build/fonts.css",
    "./package.json": "./package.json",
    "./chat/activity": {
      "types": "./dist/components/chat/activity.d.ts",
      "import": "./dist/components/chat/activity.js",
      "default": "./dist/components/chat/activity.js"
    },
    "./chat/controller": {
      "types": "./dist/components/chat/controller.d.ts",
      "import": "./dist/components/chat/controller.js",
      "default": "./dist/components/chat/controller.js"
    },
    "./chat/list": {
      "types": "./dist/components/chat/list.d.ts",
      "import": "./dist/components/chat/list.js",
      "default": "./dist/components/chat/list.js"
    },
    "./chat/message-actions": {
      "types": "./dist/components/chat/message-actions.d.ts",
      "import": "./dist/components/chat/message-actions.js",
      "default": "./dist/components/chat/message-actions.js"
    },
    "./chat/model-picker": {
      "types": "./dist/components/chat/model-picker.d.ts",
      "import": "./dist/components/chat/model-picker.js",
      "default": "./dist/components/chat/model-picker.js"
    },
    "./chat/parts": {
      "types": "./dist/components/chat/parts.d.ts",
      "import": "./dist/components/chat/parts.js",
      "default": "./dist/components/chat/parts.js"
    },
    "./chat/question": {
      "types": "./dist/components/chat/question.d.ts",
      "import": "./dist/components/chat/question.js",
      "default": "./dist/components/chat/question.js"
    },
    "./chat/sources": {
      "types": "./dist/components/chat/sources.d.ts",
      "import": "./dist/components/chat/sources.js",
      "default": "./dist/components/chat/sources.js"
    },
    "./chat/tool-call": {
      "types": "./dist/components/chat/tool-call.d.ts",
      "import": "./dist/components/chat/tool-call.js",
      "default": "./dist/components/chat/tool-call.js"
    },
    "./button/group": {
      "types": "./dist/components/button/group.d.ts",
      "import": "./dist/components/button/group.js",
      "default": "./dist/components/button/group.js"
    },
    "./badge/status-light": {
      "types": "./dist/components/badge/status-light.d.ts",
      "import": "./dist/components/badge/status-light.js",
      "default": "./dist/components/badge/status-light.js"
    },
    "./chart/sparkline": {
      "types": "./dist/components/chart/sparkline.d.ts",
      "import": "./dist/components/chart/sparkline.js",
      "default": "./dist/components/chart/sparkline.js"
    },
    "./text-diff/inline": {
      "types": "./dist/components/text-diff/inline.d.ts",
      "import": "./dist/components/text-diff/inline.js",
      "default": "./dist/components/text-diff/inline.js"
    },
    "./modal/controller": {
      "types": "./dist/components/modal/controller.d.ts",
      "import": "./dist/components/modal/controller.js",
      "default": "./dist/components/modal/controller.js"
    },
    "./tooltip/truncation": {
      "types": "./dist/components/tooltip/truncation.d.ts",
      "import": "./dist/components/tooltip/truncation.js",
      "default": "./dist/components/tooltip/truncation.js"
    },
    "./scroll-region/overview": {
      "types": "./dist/components/scroll-region/overview.d.ts",
      "import": "./dist/components/scroll-region/overview.js",
      "default": "./dist/components/scroll-region/overview.js"
    },
    "./hover-card/preview": {
      "types": "./dist/components/hover-card/preview.d.ts",
      "import": "./dist/components/hover-card/preview.js",
      "default": "./dist/components/hover-card/preview.js"
    }
  },
  "bin": {
    "ui-components-labs": "bin/serve-labs.mjs",
    "ui-components-tooling": "tooling/bin.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "labs/build/reference.css",
    "labs/build/fonts.css",
    "labs/build/vendor/fonts",
    "bin/serve-labs.mjs",
    "bin/lab-server.mjs",
    "tooling",
    "specs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "cleanup": "node scripts/cleanup.mjs",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json && node scripts/copy-locales.mjs",
    "build:package": "npm run build && node scripts/build-labs.mjs --reference",
    "prepare": "node scripts/prepare.mjs",
    "build:labs": "node scripts/build-labs.mjs",
    "generate:locales": "node scripts/generate-locales.mjs",
    "labs": "node scripts/start-labs.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo && tsc -p tsconfig.build.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck-src.tsbuildinfo && tsc -p tsconfig.scripts.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck-scripts.tsbuildinfo",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/dev --passWithNoTests",
    "test:watch": "vitest",
    "test:labs": "playwright test",
    "check:references": "node tooling/bin.mjs check-references",
    "check:specs": "node tooling/bin.mjs check-specs",
    "check:labs": "node scripts/check-labs.mjs && node scripts/check-reference-tokens.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:public-types": "node scripts/check-public-types.mjs",
    "check:git-install": "node scripts/check-git-install.mjs",
    "check:client-boundaries": "node scripts/check-client-boundaries.mjs",
    "check:server-components": "node scripts/check-server-components.mjs",
    "bench:rich-text": "npm run build && node --expose-gc scripts/bench-rich-text.mjs",
    "check": "node scripts/check.mjs",
    "new:lab": "node scripts/new-lab.mjs",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "check:structure": "node tooling/bin.mjs check-structure",
    "pack:labs": "node scripts/pack-labs.mjs"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.0",
    "@handlewithcare/react-prosemirror": "^3.2.11",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/user-event": "^14.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-simple-import-sort": ">=12.0.0",
    "globals": ">=17.0.0",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.2.0",
    "prettier": "^3.0.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "1.42.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "typescript": ">=6.0.0",
    "typescript-eslint": "^8.0.0"
  },
