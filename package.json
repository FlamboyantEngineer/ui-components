{
  "name": "@flamboyantengineer/ui-components",
  "version": "0.1.0",
  "description": "Unstyled, accessible React components that expose documented styling hooks for a host stylesheet.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamboyantEngineer/ui-components.git"
  },
  "browserslist": [
    "chrome >= 117",
    "edge >= 117",
    "firefox >= 121",
    "safari >= 17",
    "ios_saf >= 17"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./locales": {
      "types": "./dist/core/locales/index.d.ts",
      "import": "./dist/core/locales/index.js",
      "default": "./dist/core/locales/index.js"
    },
    "./locales/*.json": "./dist/core/locales/*.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./reference.css": "./labs/build/reference.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "labs/build/reference.css",
    "specs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "cleanup": "node scripts/cleanup.mjs",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json && node scripts/copy-locales.mjs",
    "build:package": "npm run build && node scripts/build-labs.mjs --reference",
    "prepare": "node scripts/prepare.mjs",
    "build:labs": "node scripts/build-labs.mjs",
    "generate:locales": "node scripts/generate-locales.mjs",
    "labs": "node scripts/start-labs.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo && tsc -p tsconfig.build.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck-src.tsbuildinfo && tsc -p tsconfig.scripts.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck-scripts.tsbuildinfo",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/dev --passWithNoTests",
    "test:watch": "vitest",
    "test:labs": "playwright test",
    "check:references": "node scripts/check-references.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:labs": "node scripts/check-labs.mjs && node scripts/check-reference-tokens.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:public-types": "node scripts/check-public-types.mjs",
    "check:git-install": "node scripts/check-git-install.mjs",
    "check:client-boundaries": "node scripts/check-client-boundaries.mjs",
    "check:server-components": "node scripts/check-server-components.mjs",
    "bench:rich-text": "npm run build && node --expose-gc scripts/bench-rich-text.mjs",
    "check": "node scripts/check.mjs",
    "new:lab": "node scripts/new-lab.mjs",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "pack:labs": "node scripts/pack-labs.mjs"
  },
  "peerDependencies": {
    "@handlewithcare/react-prosemirror": "^3.2.11",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/user-event": "^14.0.0",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.2.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "1.42.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-reconciler": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "@handlewithcare/react-prosemirror": {
      "optional": true
    },
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "prosemirror-commands": {
      "optional": true
    },
    "prosemirror-history": {
      "optional": true
    },
    "prosemirror-inputrules": {
      "optional": true
    },
    "prosemirror-keymap": {
      "optional": true
    },
    "prosemirror-model": {
      "optional": true
    },
    "prosemirror-schema-list": {
      "optional": true
    },
    "prosemirror-state": {
      "optional": true
    },
    "prosemirror-transform": {
      "optional": true
    },
    "prosemirror-view": {
      "optional": true
    },
    "react-reconciler": {
      "optional": true
    }
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "entities": "^9.0.0",
    "intl-messageformat": "^12.1.4",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-stately": "^3.51.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@handlewithcare/react-prosemirror": "^3.2.11",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "emojibase-data": "^18.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "1.42.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-reconciler": "^0.34.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2"
  }
}
