{
  // The Node scripts and the local lint rules, checked as JavaScript. Their parameters carry no
  // annotations, so an unannotated parameter is `any`; everything else is checked strictly.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.mjs", "eslint-rules/*.js"]
}
